{
  "name": "ngx-virtual-scroller-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build ngx-virtual-scroller",
    "build:lib": "ng build ngx-virtual-scroller",
    "build:demo": "ng build demo",
    "test": "ng test ngx-virtual-scroller --watch=false",
    "test:browser": "ng test ngx-virtual-scroller -c browser --watch=false",
    "e2e": "playwright test",
    "lint": "ng lint",
    "pack": "npm run build:lib && npm pack ./dist/ngx-virtual-scroller --pack-destination dist",
    "deploy:kavita": "node scripts/deploy-kavita.mjs",
    "verify": "npm run lint && npm test && npm run test:browser && npm run build:lib && npm run build:demo && npm run e2e"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.63.0",
    "@vitest/browser-playwright": "~5.0.2",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "ng-packagr": "^22.2.4",
    "playwright": "~1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
